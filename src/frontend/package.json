{
  "name": "ecologistica-frontend",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-images.mjs && tsc -b && vite build && node scripts/prerender.mjs && node scripts/precompress.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:accessibility": "node ../../scripts/audit_accessibility.mjs",
    "lint": "eslint . && tsc -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "e2e:prod": "playwright test --grep @public",
    "e2e:metrics": "node e2e/support/summarize-metrics.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "playwright": "1.64.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
