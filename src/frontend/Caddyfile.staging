(local_application) {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
    }
    # Green IT (Inspección 04): compresión de respuestas dinámicas (API JSON) a partir de 1 KB.
    encode {
        zstd
        gzip 6
        minimum_length 1024
    }
    @api path /api/* /health /docs /openapi.json
    handle @api {
        reverse_proxy backend:8000
    }
    # Recursos con hash en el nombre: inmutables durante un año.
    @assets path /assets/*
    handle @assets {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server {
            precompressed br gzip
        }
    }
    # index.html y rutas de la SPA: siempre revalidar (ETag/Last-Modified de file_server).
    handle {
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server {
            precompressed br gzip
        }
    }
}

{$STAGING_DOMAIN} {
    tls internal
    import local_application
}

http://{$STAGING_DOMAIN} {
    import local_application
}
